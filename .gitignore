# Riviera supplier price DB — ignore rules
# Data minimisation: no real supplier/customer data, no secrets, no local runtime files.

# Real supplier pricing prototype — never commit
prototype.html

# Local config holds the Cloudflare Access allow-list / settings — commit config.example.toml instead
config.toml

# Backup env holds the restic repo URL + password — server only, never commit
backup.env

# Secrets — GitHub 2FA recovery codes must NEVER be committed (belong off the repo entirely)
github-recovery-codes.txt
*recovery*

# Python virtualenvs
.venv*/

# SQLite databases (runtime only)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Runtime data and uploaded originals
data/
uploads/

# JSON data files — synthetic fixtures only; real data is never committed
*.json

# Python caches
__pycache__/
*.pyc

# local server logs
supplier-price-db/backend/uvicorn.*.log
