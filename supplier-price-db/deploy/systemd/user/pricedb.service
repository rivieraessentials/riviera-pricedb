[Unit]
Description=Riviera supplier price DB (uvicorn on 127.0.0.1:8001) - user service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/pricedb/supplier-price-db/backend
Environment=PRICEDB_CONFIG=%h/pricedb/config.toml
ExecStart=%h/pricedb/supplier-price-db/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
